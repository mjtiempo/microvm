{
  "boot-source": {
    "kernel_image_path": "images/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 root=/dev/vda rw"
  },
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048,
    "smt": false
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "images/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": false
    },
    {
      "drive_id": "persist",
      "path_on_host": "images/persist.ext4",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "host_dev_name": "fc-tap",
      "guest_mac": "06:00:AC:10:00:02"
    }
  ],
  "logger": {
    "log_path": "run/firecracker.log",
    "level": "Info",
    "show_level": true,
    "show_log_origin": true
  }
}
